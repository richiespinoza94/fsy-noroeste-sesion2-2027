# Estos 6 son los MISMOS valores que ya usas en confejas-2026 — es el mismo
# proyecto Firebase, solo cambia la base de datos (ver VITE_FIREBASE_DB_ID).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Este es NUEVO y distinto al app de CONFEJAS: el ID de la base de datos
# Firestore con nombre que creaste dentro del proyecto (ej. fsy-2027).
# Si lo dejas vacío, la app se queda en "Modo local" a propósito —
# es la protección para que nunca escriba sin querer sobre la base
# "(default)" que usa CONFEJAS.
VITE_FIREBASE_DB_ID=fsy-2027
